<Window x:Class="Wantodo.App.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速记一条"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        FontSize="15"
        UseLayoutRounding="True">

    <Border BorderThickness="1" BorderBrush="{DynamicResource Accent}" Padding="16,12,16,12">
        <StackPanel>
            <TextBox x:Name="Input"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}"
                     CaretBrush="{DynamicResource TextPrimary}"
                     FontSize="16"
                     Padding="0"
                     AcceptsReturn="False"
                     PreviewKeyDown="OnInputPreviewKeyDown" />
            <TextBlock x:Name="Hint" Style="{StaticResource HintText}" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</Window>
