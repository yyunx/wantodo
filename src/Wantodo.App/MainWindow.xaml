<Window x:Class="Wantodo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wantodo.App.ViewModels"
        Title="wantodo"
        Width="560" Height="320" MinWidth="360" MinHeight="180"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- CaptionHeight=0：整块自绘；ResizeBorderThickness 保证无边框也能从边缘拉大小 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 行内编辑框：无边框、无背景，看起来像原文字 -->
        <Style x:Key="InlineEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="#556FA8FF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 栏尾输入框 -->
        <Style x:Key="DraftBox" TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="2,4" />
        </Style>

        <!-- 顶栏小按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 勾选圆点：点击热区 18×18，视觉 13×13 -->
        <Style x:Key="CheckDot" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Width="14" Height="14" CornerRadius="4"
                                BorderThickness="1.2"
                                BorderBrush="{StaticResource TextMuted}"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick"
                                       Text="&#x2713;"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#0F1216"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：拖拽区 + 加栏 + 关闭 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <TextBlock Text="wantodo"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMuted}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button Style="{StaticResource IconButton}"
                        Height="24" Padding="6,0"
                        Command="{Binding AddColumnCommand}"
                        ToolTip="加一栏（最多 4 栏）">
                    <TextBlock Text="＋ 栏" FontSize="11" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButton}"
                        Width="30" Height="24" Margin="2,0,0,0"
                        ToolTip="关闭（暂时是这个入口，Phase 4 换成托盘）"
                        Click="OnCloseClick">
                    <TextBlock Text="&#x2715;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 栏数 = Columns.Count，由数据决定；每栏宽度由窗口算，窄到放不下时横向滚动 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ColumnsScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Margin="8,0,8,8"
                      Padding="0,0,0,2">
            <ItemsControl x:Name="ColumnsHost" ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackground}"
                                CornerRadius="10"
                                Margin="4,0"
                                Width="{Binding ColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                GotKeyboardFocus="OnColumnGotKeyboardFocus"
                                PreviewMouseLeftButtonDown="OnColumnPreviewMouseDown"
                                Padding="12,8,12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                        <DockPanel>
                            <!-- 栏头：标题（双击改名）+ 条目数 + 删栏 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Background="Transparent"
                                      MouseLeftButtonDown="OnColumnTitleMouseDown">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="SemiBold"
                                             AcceptsReturn="False"
                                             IsVisibleChanged="OnTitleEditBoxIsVisibleChanged"
                                             PreviewKeyDown="OnTitleEditBoxPreviewKeyDown"
                                             LostFocus="OnTitleEditBoxLostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding NoteCount}"
                                           FontSize="11"
                                           Margin="6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        Width="20" Height="20"
                                        FontSize="10"
                                        Click="OnDeleteColumnClick"
                                        ToolTip="删掉这一栏">
                                    <TextBlock Text="&#x2715;" FontSize="10" />
                                </Button>
                            </Grid>

                            <!-- 栏尾输入框固定在下方 -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <TextBlock Text="＋ 添加一条，回车确认"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="2,4,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DraftText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource DraftBox}"
                                         Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnDraftPreviewKeyDown" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,2,0"
                                          Background="Transparent"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          AllowDrop="True"
                                          DragOver="OnNotesDragOver"
                                          DragLeave="OnNotesDragLeave"
                                          Drop="OnNotesDrop">
                                <ItemsControl x:Name="NotesList"
                                              FocusVisualStyle="{x:Null}"
                                              ItemsSource="{Binding Notes}"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="OnNotesDragOver"
                                              DragLeave="OnNotesDragLeave"
                                              Drop="OnNotesDrop"
                                              PreviewKeyDown="OnNotesListPreviewKeyDown">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 落点线：划在「将要插到的那一行」上方 -->
                                                <Border Grid.Row="0"
                                                        Height="2"
                                                        Margin="0,0,0,1"
                                                        Background="{StaticResource Accent}"
                                                        Visibility="{Binding IsDropBefore, Converter={StaticResource BoolToVis}}" />

                                                <Grid Grid.Row="1"
                                                      x:Name="NoteRow"
                                                      Focusable="True"
                                                      FocusVisualStyle="{x:Null}"
                                                      Background="Transparent"
                                                      Margin="0,1"
                                                      PreviewMouseLeftButtonDown="OnNoteRowPreviewMouseDown"
                                                      PreviewMouseMove="OnNoteRowPreviewMouseMove"
                                                      MouseLeftButtonDown="OnNoteRowMouseLeftButtonDown">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource CheckDot}"
                                                            Command="{Binding ToggleCommand}"
                                                            ToolTip="勾选 / 取消（也可以选中这一行按空格）" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisibleChanged="OnNoteEditBoxIsVisibleChanged"
                                             PreviewKeyDown="OnNoteEditBoxPreviewKeyDown"
                                             LostFocus="OnNoteEditBoxLostFocus"
                                             Margin="0,2">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Width="18" Height="18"
                                                            Margin="4,0,0,0"
                                                            Opacity="0.35"
                                                            ToolTip="删除这一条（编辑时清空内容回车也可以）"
                                                            Click="OnDeleteNoteClick">
                                                        <TextBlock Text="&#x2715;" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
