<Window x:Class="Wantodo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wantodo.App.ViewModels"
        Title="wantodo"
        Width="560" Height="320" MinWidth="360" MinHeight="180"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- CaptionHeight=0：整块自绘；ResizeBorderThickness 保证无边框也能从边缘拉大小 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 行内编辑框：无边框、无背景，看起来像原文字 -->
        <Style x:Key="InlineEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="#556FA8FF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 栏尾输入框 -->
        <Style x:Key="DraftBox" TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="2,4" />
        </Style>

        <!-- 勾选圆点：点击热区 18×18，视觉 13×13 -->
        <Style x:Key="CheckDot" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Width="14" Height="14" CornerRadius="4"
                                BorderThickness="1.2"
                                BorderBrush="{DynamicResource TextMuted}"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick"
                                       Text="&#x2713;"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#0F1216"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 一栏的内容（标题 / 列表 / 栏尾输入），由停靠布局的叶子节点实例化 -->
                    <DataTemplate x:Key="PaneTemplate">
                        <Border Background="{DynamicResource CardBackground}"
                                CornerRadius="10"
                                Margin="4"
                                AllowDrop="True"
                                DragOver="OnPaneDragOver"
                                DragLeave="OnPaneDragLeave"
                                Drop="OnPaneDrop"

                                GotKeyboardFocus="OnColumnGotKeyboardFocus"
                                PreviewMouseLeftButtonDown="OnColumnPreviewMouseDown"
                                Padding="12,8,12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                        <DockPanel>
                            <!-- 拖动条：像手机小窗顶部的把手，按住它可以把整栏拖到别处 -->
                            <Border DockPanel.Dock="Top"
                                    Height="12"
                                    Margin="0,0,0,1"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    ToolTip="按住拖到别的栏边缘，可以把这一栏停靠过去"
                                    PreviewMouseLeftButtonDown="OnPaneGripMouseDown"
                                    PreviewMouseMove="OnPaneGripMouseMove">
                                <Border Width="38" Height="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="2"
                                        Background="{DynamicResource Divider}" />
                            </Border>

                            <!-- 栏头：标题（双击改名）+ 条目数 + 删栏 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Background="Transparent"
                                      MouseLeftButtonDown="OnColumnTitleMouseDown"
                                      MouseRightButtonUp="OnPaneHeaderMouseRightButtonUp"
                                      PreviewMouseMove="OnPaneHeaderPreviewMouseMove">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="SemiBold"
                                             AcceptsReturn="False"
                                             IsVisibleChanged="OnTitleEditBoxIsVisibleChanged"
                                             PreviewKeyDown="OnTitleEditBoxPreviewKeyDown"
                                             LostFocus="OnTitleEditBoxLostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding NoteCount}"
                                           FontSize="11"
                                           Margin="6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        Width="20" Height="20"
                                        FontSize="10"
                                        Click="OnDeleteColumnClick"
                                        ToolTip="删掉这一栏">
                                    <TextBlock Text="&#x2715;" FontSize="10" />
                                </Button>
                            </Grid>

                            <!-- 栏尾输入框固定在下方 -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <TextBlock Text="＋ 添加一条，回车确认"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="2,4,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DraftText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource DraftBox}"
                                         Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnDraftPreviewKeyDown" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,2,0"
                                          Background="Transparent"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          AllowDrop="True"
                                          DragOver="OnNotesDragOver"
                                          DragLeave="OnNotesDragLeave"
                                          Drop="OnNotesDrop">
                                <ItemsControl x:Name="NotesList"
                                              FocusVisualStyle="{x:Null}"
                                              ItemsSource="{Binding Notes}"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="OnNotesDragOver"
                                              DragLeave="OnNotesDragLeave"
                                              Drop="OnNotesDrop"
                                              PreviewKeyDown="OnNotesListPreviewKeyDown">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 落点线：划在「将要插到的那一行」上方 -->
                                                <Border Grid.Row="0"
                                                        Height="2"
                                                        Margin="0,0,0,1"
                                                        Background="{DynamicResource Accent}"
                                                        Visibility="{Binding IsDropBefore, Converter={StaticResource BoolToVis}}" />

                                                <Grid Grid.Row="1"
                                                      x:Name="NoteRow"
                                                      Focusable="True"
                                                      FocusVisualStyle="{x:Null}"
                                                      Background="Transparent"
                                                      Margin="0,1"
                                                      PreviewMouseLeftButtonDown="OnNoteRowPreviewMouseDown"
                                                      PreviewMouseMove="OnNoteRowPreviewMouseMove"
                                                      MouseLeftButtonDown="OnNoteRowMouseLeftButtonDown">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <!-- 卡住清单里有同名条目才提示；没有就不设 ToolTip（空提示框会闪白） -->
                                                            <Setter Property="ToolTip" Value="{Binding BlockerHint}" />
                                                            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
                                                            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBlocker}" Value="False">
                                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource CheckDot}"
                                                            Command="{Binding ToggleCommand}"
                                                            ToolTip="勾选 / 取消（也可以选中这一行按空格）" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisibleChanged="OnNoteEditBoxIsVisibleChanged"
                                             PreviewKeyDown="OnNoteEditBoxPreviewKeyDown"
                                             LostFocus="OnNoteEditBoxLostFocus"
                                             Margin="0,2">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditBox}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Width="18" Height="18"
                                                            Margin="4,0,0,0"
                                                            Opacity="0.35"
                                                            ToolTip="删除这一条（编辑时清空内容回车也可以）"
                                                            Click="OnDeleteNoteClick">
                                                        <TextBlock Text="&#x2715;" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：品牌区 + 加栏 / 随心记 / 关闭；空白处按住可拖窗口 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="14,0,0,0" IsHitTestVisible="False">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0" />
                <TextBlock Text="wantodo" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="AddColumnButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="OnAddColumnClick"
                        AutomationProperties.Name="加栏"
                        IsEnabled="{Binding CanAddColumn}"
                        ToolTip="加一栏（会给它起个名）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="加栏" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Margin="6,0,0,0"
                        Click="OnBlockersClick"
                        AutomationProperties.Name="卡住清单"
                        AllowDrop="True"
                        DragOver="OnBlockersButtonDragOver"
                        Drop="OnBlockersButtonDrop"
                        ToolTip="卡住清单：想做 ⇄ 卡在什么地方（也可以把主界面的条目拖进去）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="卡住" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Margin="6,0,0,0"
                        Click="OnNotesClick"
                        AutomationProperties.Name="随心记"
                        ToolTip="随心记：打开笔记库（随手记一笔也可以按 Ctrl+Alt+Space）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="随心记" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="14" Margin="8,0" Background="{DynamicResource Divider}" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource TitleBarCloseButton}"
                        Click="OnCloseClick"
                        ToolTip="隐藏到托盘（右键托盘图标可退出）">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 栏数 = Columns.Count，由数据决定；每栏宽度由窗口算，窄到放不下时横向滚动 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ColumnsScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Margin="8,0,8,8"
                      Padding="0,0,0,2">
            <Grid x:Name="LayoutHost" />
        </ScrollViewer>

        <!-- 拖拽时的「预设位置」预览：半透明色块盖住将会占用的那半边 -->
        <Canvas x:Name="DropPreviewLayer" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="DropPreviewBox"
                    Visibility="Collapsed"
                    Background="#336FA8FF"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1.5"
                    CornerRadius="8" />
        </Canvas>
    </Grid>
</Window>
