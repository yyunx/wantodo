<Window x:Class="Wantodo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wantodo"
        Width="560" Height="320" MinWidth="360" MinHeight="180"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- CaptionHeight=0：整块自绘；ResizeBorderThickness 保证无边框也能从边缘拉大小 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：拖拽区 + 关闭 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <TextBlock Text="wantodo"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMuted}" />

            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="30" Height="24" Margin="0,0,6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource TextMuted}"
                    Cursor="Hand"
                    ToolTip="关闭（Phase 1 的临时入口，Phase 4 换成托盘图标）"
                    Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#x2715;" FontSize="10" />
            </Button>
        </Grid>

        <!-- 栏数 = Columns.Count，由数据决定；这里不写死两栏 -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Columns}"
                      Margin="8,0,8,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="{Binding Columns.Count}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBackground}"
                            CornerRadius="10"
                            Margin="4,0"
                            Padding="12,10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Notes.Count}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}" />
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="&#x2022;"
                                                           FontSize="12"
                                                           VerticalAlignment="Top"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
