<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wantodo.Core\Wantodo.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 System.Windows.Forms.NotifyIcon：Windows Desktop SDK 自带，不是第三方 NuGet -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\wantodo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <AssemblyName>Wantodo</AssemblyName>
    <RootNamespace>Wantodo.App</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      WinForms 分析器会要求把 DPI 设置从 manifest 挪到 ApplicationHighDpiMode。
      但本项目是 WPF 应用（只是借 NotifyIcon），DPI 认知以 manifest 里的 PerMonitorV2 为准，
      所以这里显式关掉那条规则，并在 docs/verify 里用 GetProcessDpiAwareness 实测确认。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\wantodo.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms 会把 System.Windows.Forms / System.Drawing 塞进全局 using，
    与本项目的 WPF 类型（Application、TextBox、Point、DragEventArgs…）大面积撞名。
    这里只想要 NotifyIcon，所以移除这两个隐式 using，需要时用全名引用。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
