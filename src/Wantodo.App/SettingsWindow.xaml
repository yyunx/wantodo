<Window x:Class="Wantodo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border BorderThickness="1" BorderBrush="{DynamicResource Divider}" Padding="18,14,18,16">
        <StackPanel>
            <!-- 标题栏（可拖动） -->
            <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,12"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" />
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Foreground="{DynamicResource TextMuted}"
                        Click="OnCloseClick" />
            </Grid>

            <TextBlock Text="层级" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="DesktopRadio" Content="桌面层" GroupName="surface" Margin="0,0,14,0"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnSurfaceChanged" />
                <RadioButton x:Name="NormalRadio" Content="普通窗口" GroupName="surface" Margin="0,0,14,0"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnSurfaceChanged" />
                <RadioButton x:Name="TopmostRadio" Content="置顶" GroupName="surface"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnSurfaceChanged" />
            </StackPanel>

            <TextBlock Text="外观" Style="{StaticResource FieldLabel}" />
            <WrapPanel Margin="0,0,0,10">
                <RadioButton x:Name="SystemRadio" Content="跟随系统" Tag="System" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="DarkRadio" Content="GitHub 深色" Tag="Dark" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="LightRadio" Content="GitHub 浅色" Tag="Light" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="DraculaRadio" Content="Dracula" Tag="Dracula" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="NordRadio" Content="Nord" Tag="Nord" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
                <RadioButton x:Name="CatppuccinRadio" Content="Catppuccin Mocha" Tag="Catppuccin" GroupName="theme" Margin="0,0,12,6"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnThemeChanged" />
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="CustomThemeButton" Content="自定义…" Padding="10,3" Click="OnCustomThemeClick" />
                <TextBlock x:Name="CustomThemeHint" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="背景 + 强调两色，其余自动推导" />
            </StackPanel>

            <TextBlock Text="色调强度" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="ToneSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                    Margin="0,0,0,12"
                    ValueChanged="OnToneChanged" />

            <TextBlock Text="窗口尺寸" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="AutoFitRadio" Content="跟随栏数" GroupName="sizeMode" Margin="0,0,14,0"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnSizeModeChanged" />
                <RadioButton x:Name="ManualSizeRadio" Content="固定" GroupName="sizeMode"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnSizeModeChanged" />
            </StackPanel>

            <CheckBox x:Name="HideCompletedCheck" Content="隐藏已完成的条目"
                      Foreground="{DynamicResource TextPrimary}"
                      Margin="0,0,0,8"
                      Checked="OnHideCompletedChanged"
                      Unchecked="OnHideCompletedChanged" />

            <CheckBox x:Name="AutostartCheck" Content="开机自启（写入当前用户 Run 项）"
                      Foreground="{DynamicResource TextPrimary}"
                      Margin="0,0,0,4"
                      Checked="OnAutostartChanged"
                      Unchecked="OnAutostartChanged" />

            <TextBlock Text="随心记默认类型" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="TxtRadio" Content="纯文本 .txt" GroupName="noteFormat" Margin="0,0,14,0"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnNoteFormatChanged" />
                <RadioButton x:Name="MdRadio" Content="Markdown .md" GroupName="noteFormat"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="OnNoteFormatChanged" />
            </StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Text="快速记一条：Ctrl+Alt+Space，回车即入库，Esc 取消。"
                       Margin="0,8,0,0" />

            <Separator Margin="0,12,0,10" Background="{DynamicResource Divider}" Height="1" />

            <TextBlock Text="数据位置" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="DataRootText"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,2" />
            <TextBlock x:Name="DataFreeText"
                       Style="{StaticResource HintText}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="打开目录" Margin="0,0,8,0" Padding="10,3" Click="OnOpenDataFolderClick" />
                <Button Content="迁移到…" Margin="0,0,8,0" Padding="10,3" Click="OnMigrateClick" />
                <Button x:Name="CleanLegacyButton" Content="清理旧数据" Padding="10,3"
                        Click="OnCleanLegacyClick" />
            </StackPanel>
            <TextBlock Style="{StaticResource HintText}"
                       Text="数据默认放在非系统盘；迁移会复制文件并写指针，重启后生效，旧目录不会自动删除。"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
