<Window x:Class="Wantodo.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随心记"
        Width="720"
        Height="540"
        MinWidth="560"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="随心记" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="RootHint" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Content="＋ 新建" Style="{StaticResource IconButton}" Padding="9,0" Height="24" Margin="0,0,8,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip="新建一篇笔记：先起名字（会用作文件名），留空则先用「未命名」"
                            Click="OnNewClick" />
                    <Button Content="打开文件夹" Style="{StaticResource IconButton}" Padding="9,0" Height="24" Margin="0,0,8,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Click="OnOpenFolderClick" />
                    <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource IconButton}" Padding="9,0" Height="24" Margin="0,0,8,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip="移到 trash\，可从回收目录找回"
                            Click="OnDeleteClick" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Width="30" Height="24"
                            FontSize="11"
                            Foreground="{DynamicResource TextMuted}"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：列表 -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10"
                        BorderThickness="1" BorderBrush="{DynamicResource Divider}">
                    <ListBox x:Name="NotesList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}"
                             SelectionChanged="OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6,6,7"
                                            ToolTip="{Binding RelativePath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="3" Padding="4,0,4,1" Margin="0,0,6,0"
                                                Background="{DynamicResource Divider}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormatBadge}" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="12.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="10.5"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 右：编辑器 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TitleBox"
                             Grid.Row="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             FontSize="17"
                             FontWeight="SemiBold"
                             Margin="6,2,6,8"
                             TextChanged="OnEditorTextChanged" />

                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10"
                            BorderThickness="0">
                        <TextBox x:Name="BodyBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 BorderBrush="Transparent"
                                 FocusVisualStyle="{x:Null}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 SelectionBrush="{DynamicResource Accent}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 TextChanged="OnEditorTextChanged" />
                    </Border>

                    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="6,8,6,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"
                               Text="自动保存 · 文件在 notes\ 下，外部编辑器改了会同步刷新" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
