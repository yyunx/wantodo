<Window x:Class="Wantodo.App.Windows.TopPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wantodo.App.Controls"
        Width="760" Height="320"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        Background="{DynamicResource CardBackground}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="PanelPaneTemplate">
            <Border Margin="2,0" Padding="6,4" Background="{DynamicResource CardBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="2,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ToggleCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" Padding="4,2" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="14" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☐" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Text" Value="☑" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource CardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="HandleArea" Grid.Row="0" Background="Transparent" Cursor="SizeNS">
            <Border x:Name="HandlePill" Width="88" Height="3" Margin="0,5,0,0" CornerRadius="1.5"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Opacity="0.45"
                    Background="{DynamicResource Accent}" />
        </Border>

        <Border x:Name="BodyBorder" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,1,1">
            <Grid Margin="18,8,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <!-- 霓虹形式下给 wordmark 叠一层错位发光；其余形式只显示最上面那层 -->
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="便签" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Glow}"
                                   Visibility="{DynamicResource ThemeGlowVisible}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="-1" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="便签" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"
                                   Visibility="{DynamicResource ThemeGlowVisible}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="1" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="便签" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                    <TextBlock Text="按住顶部把手拖动；Esc 或点面板外收起"
                               Foreground="{DynamicResource TextMuted}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ColumnsScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <controls:BoardLayoutHost x:Name="LayoutHost" />
                    </ScrollViewer>

                    <Grid x:Name="CanvasBody" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 固定三层工具栏（plan §5.4）：① 切换器行 ② 当前表面工具组 ③ 状态行；合计 ≤88 DIP -->
                        <StackPanel Margin="0,0,0,6">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Padding="2" CornerRadius="8"
                                        Background="{DynamicResource BorderSubtle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="SurfaceStructuredButton" Content="结构化"
                                                      Style="{StaticResource SurfaceSegment}"
                                                      Click="OnSurfaceButtonClick" />
                                        <ToggleButton x:Name="SurfaceFreeformButton" Content="自由"
                                                      Style="{StaticResource SurfaceSegment}"
                                                      Click="OnSurfaceButtonClick" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="SurfaceAddButton" DockPanel.Dock="Left" Content="＋"
                                        Margin="6,0,0,0" Padding="7,2" MinWidth="26"
                                        ToolTip="0.7.0 只有两个表面" Click="OnSurfaceAddClick" />
                                <TextBlock x:Name="ToolHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            </DockPanel>

                            <StackPanel x:Name="StructuredTools" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="记事" Click="OnCanvasAddNote" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="待办" Click="OnCanvasAddTodo" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="计时" Click="OnCanvasAddTimer" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="图片" Click="OnCanvasAddImage" Padding="8,3" />
                            </StackPanel>

                            <!-- 自由表面十工具：选择/手形/文本/图片/矩形/线/箭头/画笔/橡皮/缩放（互斥高亮） -->
                            <DockPanel x:Name="FreeformTools" Margin="0,6,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ToolSelect" Content="选" Tag="select" Style="{StaticResource ToolToggle}"
                                                  ToolTip="选择（V）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolPan" Content="手" Tag="pan" Style="{StaticResource ToolToggle}"
                                                  ToolTip="手形（H，空格临时）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolText" Content="T" Tag="text" Style="{StaticResource ToolToggle}"
                                                  ToolTip="文本（T）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolImage" Content="图" Tag="image" Style="{StaticResource ToolToggle}"
                                                  ToolTip="图片" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolRect" Content="▭" Tag="rect" Style="{StaticResource ToolToggle}"
                                                  ToolTip="矩形（R）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolLine" Content="／" Tag="line" Style="{StaticResource ToolToggle}"
                                                  ToolTip="线" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolArrow" Content="↗" Tag="arrow" Style="{StaticResource ToolToggle}"
                                                  ToolTip="箭头（A）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolInk" Content="笔" Tag="ink" Style="{StaticResource ToolToggle}"
                                                  ToolTip="画笔（B）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolEraser" Content="擦" Tag="eraser" Style="{StaticResource ToolToggle}"
                                                  ToolTip="橡皮（E）" Click="OnToolClick" />
                                    <ToggleButton x:Name="ToolZoom" Content="放" Tag="zoom" Style="{StaticResource ToolToggle}"
                                                  ToolTip="缩放（点击放大，Shift+点击缩小）" Click="OnToolClick" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="−" Click="OnZoomOut" Padding="7,2" MinWidth="26" ToolTip="缩小（滚轮也可）" />
                                    <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="42" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="4,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <Button Content="＋" Click="OnZoomIn" Padding="7,2" MinWidth="26" ToolTip="放大" />
                                    <Button Content="适应" Click="OnZoomFit" Padding="7,2" Margin="4,0,0,0" ToolTip="适应内容（25%–400%）" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="CanvasStatus" Margin="0,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CanvasScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <controls:CanvasBoard x:Name="CanvasBoard" Width="1600" Height="1000" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="FreeformScroller" Visibility="Collapsed"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <controls:FreeformBoard x:Name="FreeformBoard" Width="1600" Height="1000" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <DockPanel x:Name="DockFooter" Grid.Row="2" Margin="0,8,0,0">
                    <ComboBox x:Name="ColumnPicker" DockPanel.Dock="Left" Width="150" Margin="0,0,8,0"
                              ItemsSource="{Binding Columns}" DisplayMemberPath="Title"
                              SelectedIndex="0" />
                    <TextBox x:Name="QuickBox" Padding="6,4" KeyDown="OnQuickAddKeyDown"
                             Background="{DynamicResource WindowBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Divider}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
