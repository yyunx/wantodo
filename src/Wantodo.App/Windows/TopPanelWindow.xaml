<Window x:Class="Wantodo.App.Windows.TopPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="320"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        Background="{DynamicResource CardBackground}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Background="{DynamicResource CardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="HandleArea" Grid.Row="0" Background="Transparent" Cursor="SizeNS">
            <Border x:Name="HandlePill" Width="88" Height="3" Margin="0,5,0,0" CornerRadius="1.5"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Opacity="0.45"
                    Background="{DynamicResource Accent}" />
        </Border>

        <Border x:Name="BodyBorder" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,1,1">
            <Grid Margin="18,8,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="便签" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="按住顶部把手拖动；Esc 或点面板外收起"
                               Foreground="{DynamicResource TextMuted}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding ToggleCommand}"
                                                        HorizontalContentAlignment="Stretch"
                                                        BorderThickness="0" Padding="4,2" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Width="14" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource TextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="☐" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Text" Value="☑" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <ComboBox x:Name="ColumnPicker" DockPanel.Dock="Left" Width="150" Margin="0,0,8,0"
                              ItemsSource="{Binding Columns}" DisplayMemberPath="Title"
                              SelectedIndex="0" />
                    <TextBox x:Name="QuickBox" Padding="6,4" KeyDown="OnQuickAddKeyDown"
                             Background="{DynamicResource WindowBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Divider}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
