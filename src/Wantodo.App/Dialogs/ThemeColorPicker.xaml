<Window x:Class="Wantodo.App.Dialogs.ThemeColorPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义主题"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border BorderThickness="1" BorderBrush="{DynamicResource Divider}" Padding="16,12,16,14">
        <StackPanel>
            <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,10"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <TextBlock Text="自定义主题" FontSize="15" FontWeight="SemiBold" />
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Foreground="{DynamicResource TextMuted}"
                        Click="OnCancelClick" />
            </Grid>

            <TextBlock Style="{StaticResource HintText}"
                       Text="只选背景与强调两色，正文、次要、弱化与强调上的文字由程序按对比度推导。"
                       Margin="0,0,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BackgroundChoice" Grid.Column="0" Margin="0,0,6,0" Padding="8,6"
                        BorderThickness="2" CornerRadius="6"
                        BorderBrush="{DynamicResource Accent}"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnBackgroundChoiceClick">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BackgroundSwatch" Width="34" Height="22" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource Divider}" />
                        <TextBlock Text="背景" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="AccentChoice" Grid.Column="1" Padding="8,6"
                        BorderThickness="2" CornerRadius="6"
                        BorderBrush="{DynamicResource Divider}"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnAccentChoiceClick">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AccentSwatch" Width="34" Height="22" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource Divider}" />
                        <TextBlock Text="强调色" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="色相" Style="{StaticResource FieldLabel}" />
            <Border Height="10" CornerRadius="5" Margin="0,0,0,2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.17" />
                        <GradientStop Color="#FF00FF00" Offset="0.33" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.67" />
                        <GradientStop Color="#FFFF00FF" Offset="0.83" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
                    Margin="0,0,0,8"
                    ValueChanged="OnHueChanged" />

            <TextBlock Text="饱和度 / 明度" Style="{StaticResource FieldLabel}" />
            <Border x:Name="SvArea" Height="120" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource Divider}" Margin="0,0,0,8"
                    MouseLeftButtonDown="OnSvMouseDown"
                    MouseMove="OnSvMouseMove"
                    MouseLeftButtonUp="OnSvMouseUp">
                <Grid>
                    <Border x:Name="SvHueBase" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="色值" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HexBox" Width="110" Padding="6,3"
                         KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
                <TextBlock x:Name="HexHint" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Margin="8,0,0,0" Text="支持 #RRGGBB，回车确认" />
            </StackPanel>

            <Border x:Name="PreviewCard" CornerRadius="8" BorderThickness="1" Padding="12,10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="PreviewTitle" Text="预览标题" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewSecondary" Text="次要说明文字，用来看是否还读得清" Margin="0,2,0,0" />
                    <TextBlock x:Name="PreviewMuted" Text="2026-11-14 20:00" Margin="0,2,0,8" />
                    <Border x:Name="PreviewAccentChip" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock x:Name="PreviewAccentText" Text="强调按钮" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="RatioText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Margin="0,0,8,0" Padding="14,4" Click="OnCancelClick" />
                <Button Content="应用" Padding="14,4" IsDefault="True" Click="OnApplyClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
