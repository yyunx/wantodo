<Window x:Class="Wantodo.App.Dialogs.TimerSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计时"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource CardBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Padding="18,16,18,14">
        <StackPanel>
            <TextBlock Text="计时" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

            <TextBlock Text="玩法" Style="{StaticResource FieldLabel}" />
            <WrapPanel>
                <RadioButton x:Name="StopwatchRadio" Content="正计时" GroupName="mode" Margin="0,0,14,6"
                             Checked="OnModeChanged" Foreground="{DynamicResource TextPrimary}" />
                <RadioButton x:Name="CountdownRadio" Content="倒计时" GroupName="mode" Margin="0,0,14,6"
                             IsChecked="True" Checked="OnModeChanged" Foreground="{DynamicResource TextPrimary}" />
                <RadioButton x:Name="AlarmRadio" Content="闹钟" GroupName="mode" Margin="0,0,14,6"
                             Checked="OnModeChanged" Foreground="{DynamicResource TextPrimary}" />
                <RadioButton x:Name="PomodoroRadio" Content="番茄钟" GroupName="mode" Margin="0,0,14,6"
                             Checked="OnModeChanged" Foreground="{DynamicResource TextPrimary}" />
            </WrapPanel>

            <StackPanel x:Name="DurationPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="时长" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="MinutesBox" Width="56" Height="28" Padding="6,0" Text="25"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         Background="{DynamicResource CardBackground}"
                         BorderBrush="{DynamicResource Divider}" />
                <TextBlock Text="分" Margin="4,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox x:Name="SecondsBox" Width="48" Height="28" Padding="6,0" Text="0"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}"
                         Background="{DynamicResource CardBackground}"
                         BorderBrush="{DynamicResource Divider}" />
                <TextBlock Text="秒" Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <StackPanel x:Name="PomodoroPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <CheckBox x:Name="CustomCheck" Content="自定义分段（最多 4 段）"
                          Checked="OnCustomChanged" Unchecked="OnCustomChanged"
                          Foreground="{DynamicResource TextPrimary}" />
                <Grid x:Name="SimplePanel" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="组数" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="GroupsBox" Grid.Column="1" Width="44" Height="28" Padding="6,0" Text="4"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="{DynamicResource CardBackground}"
                             BorderBrush="{DynamicResource Divider}" />
                    <TextBlock Grid.Column="2" Text="专注" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="FocusBox" Grid.Column="3" Width="44" Height="28" Padding="6,0" Text="25"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="{DynamicResource CardBackground}"
                             BorderBrush="{DynamicResource Divider}" />
                    <TextBlock Grid.Column="4" Text="休息" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="BreakBox" Grid.Column="5" Width="44" Height="28" Padding="6,0" Text="5"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="{DynamicResource CardBackground}"
                             BorderBrush="{DynamicResource Divider}" />
                </Grid>
                <StackPanel x:Name="CustomPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="SegmentRows" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="＋ 再加一段" Height="24" Padding="8,0" FontSize="11"
                                Click="OnAddSegment" ToolTip="最多 4 段" />
                        <Button Content="删掉最后一段" Height="24" Padding="8,0" FontSize="11" Margin="8,0,0,0"
                                Click="OnRemoveSegment" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="PomodoroHint" Style="{StaticResource HintText}" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock x:Name="Hint" Text="到点后右下角提醒一次，并响一声。"
                       Style="{StaticResource HintText}" Margin="0,8,0,0" />


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource TitleBarButton}" Height="28" Padding="14,0"
                        Content="取消" Click="OnCancelClick" />
                <Button Style="{StaticResource TitleBarButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                        Content="设置完成" IsDefault="True" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
