<Window x:Class="Wantodo.App.Dialogs.NewNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建笔记"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource CardBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Padding="18,16,18,14">
        <StackPanel>
            <TextBlock Text="新建笔记" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

            <TextBlock Text="先起个名字，会直接用作文件名" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox"
                     Height="30"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     Foreground="{DynamicResource TextPrimary}"
                     Background="#0F1621"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource Divider}"
                     CaretBrush="{DynamicResource TextPrimary}"
                     TextChanged="OnNameChanged"
                     PreviewKeyDown="OnNameBoxPreviewKeyDown" />

            <TextBlock x:Name="FilePreview" Style="{StaticResource HintText}" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="回车确认，Esc 取消；留空则先用「未命名」，之后首次改标题会同步文件名。"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource TitleBarButton}" Height="28" Padding="14,0"
                        Content="取消" Click="OnCancelClick" />
                <Button Style="{StaticResource TitleBarButton}" Height="28" Padding="14,0" Margin="8,0,0,0"
                        Content="确定" IsDefault="True" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
