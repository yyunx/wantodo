<Window x:Class="Wantodo.App.BlockersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卡住清单"
        Width="780"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0" />
                <TextBlock Text="卡住清单" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="PathText" Margin="12,0,0,0"
                       VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource TitleBarButton}" Click="OnAddRowClick" AutomationProperties.Name="加一行"
                        ToolTip="加一行（也可以把主界面里的条目拖进来）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="加一行" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Margin="6,0,0,0" Click="OnOpenFolderClick" AutomationProperties.Name="打开文件夹"
                        ToolTip="在资源管理器里打开（文件就是 blockers.md，Obsidian 也能直接打开）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="打开文件夹" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="14" Margin="8,0" Background="{DynamicResource Divider}" />
                <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick" AutomationProperties.Name="关闭卡住清单" ToolTip="关闭（Esc）">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 表头 -->
        <Grid Grid.Row="1" Margin="16,4,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="想做" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Grid.Column="2" Text="卡在什么地方" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
        </Grid>

        <!-- 行列表：可拖入主界面的条目 -->
        <ScrollViewer Grid.Row="2" Margin="16,0,16,0" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}"
                          AllowDrop="True" DragOver="OnRowsDragOver" Drop="OnRowsDrop">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="8"
                                Padding="8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Want, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="False"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         FontSize="12.5" Padding="2,4" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding Blocker, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="False"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextSecondary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         FontSize="12.5" Padding="2,4" />

                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                        Width="24" Height="24" VerticalAlignment="Top"
                                        Click="OnDeleteRowClick" ToolTip="删掉这一行">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="16,8,16,10"
                   FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap" Text="拖主界面里的条目到这张表上，就会多一行；「卡在什么地方」填了原因后，主界面里悬停这个名字会显示它。" />
    </Grid>
</Window>
